# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── secrets ──────────────────────────────────────────────────────────
# Generate both. Do not reuse, do not paste from anywhere.
#   openssl rand -base64 48
JWT_SECRET=
#   openssl rand -hex 32
OCR_SERVICE_TOKEN=
MONGO_PASSWORD=

# ── mongo ────────────────────────────────────────────────────────────
MONGO_USER=medicalocr

# ── api ──────────────────────────────────────────────────────────────
API_PORT=8080
JWT_EXPIRATION_MS=86400000
LOG_LEVEL=INFO

# Comma-separated origins allowed to call the API.
# Add your Netlify URL here once deployed.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── ocr ──────────────────────────────────────────────────────────────
OCR_LANG=en

# ── local static frontend (docker compose --profile with-web) ────────
WEB_PORT=5173
